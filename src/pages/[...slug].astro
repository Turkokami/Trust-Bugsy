---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pages, crumbsFor, nodeFor, type ClonePage } from '@/lib/pages';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpokeLinks from '@/components/SpokeLinks.astro';
import ReadNext from '@/components/ReadNext.astro';

export function getStaticPaths() {
  return pages
    .filter((m) => m.frontmatter.path !== '/')
    .map((m) => ({ params: { slug: m.frontmatter.path.replace(/^\/|\/$/g, '') }, props: { mod: m } }));
}
const { mod } = Astro.props;
const fm = mod.frontmatter as ClonePage;
const { Content } = mod;
const crumbs = crumbsFor(fm);
const node = nodeFor(fm.path);
const isPost = fm.type === 'blog' && !['/blogs/', '/blog/'].includes(fm.path);
const readNext = isPost ? node?.links.find((g) => g.title === 'Read next') : undefined;
const spokes = (node?.links ?? []).filter((g) => g !== readNext);
// The page body (hero or banner, quote forms, shared sections) is laid out by
// src/lib/rehype-bugsy.mjs from the copied markdown.
---
<BaseLayout title={fm.title} description={fm.description} path={fm.path} crumbs={crumbs} office={node?.office} city={node?.cityName}
  service={fm.service ?? node?.serviceName} faqs={fm.faqs} image={fm.image}
  article={fm.type === 'blog' && !['/blogs/', '/blog/'].includes(fm.path) ? { headline: fm.h1, author: fm.author, published: fm.published } : undefined}>
  <Breadcrumbs crumbs={crumbs} />
  <div class={`tb-page tb-type-${fm.type} tb-kind-${node?.kind ?? fm.type}`}><Content /></div>
  <ReadNext group={readNext} />
  <SpokeLinks groups={spokes} />
</BaseLayout>
