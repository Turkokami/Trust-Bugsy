---
import { business, hq } from '@/data/business';
const year = new Date().getFullYear();
const pompano = business.locations[1];
// Same columns as the live footer: logo and tagline, Quick Links, Services,
// Contact Us, a "Need Professional Pest Help Today?" call box, copyright bar.
const quick: [string, string][] = [
  ['Home', '/'], ['About', '/about/'], ['Contact', '/contact/'], ['Our Plans', '/packages/'],
  ['Blogs', '/blog/'], ['Reviews', '/reviews/'], ['Faq’s', '/#faqs'], ['Privacy Policy', '/privacy-policy/'],
];
const services: [string, string][] = [
  ['Residential Pest Control', '/residential-pest-control/'], ['Commercial Pest Control', '/commercial/'],
  ['Termite Control', '/termite-control/'], ['Mosquito Control', '/mosquito-control/'],
  ['Insulation Replacement', '/insulation-replacement/'],
];
const ico = {
  mail: 'M3 5h18v14H3zm9 7L4.5 6.8V7l7.5 5 7.5-5v-.2z',
  phone: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z',
  globe: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8 8 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4zm.8 2h3a15.7 15.7 0 0 0 1.4 3.6A8 8 0 0 1 5.1 16zm3-8h-3a8 8 0 0 1 4.4-3.6C8.9 5.5 8.4 6.7 8.1 8zM12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h3a8 8 0 0 1-4.4 3.6zM16.3 14a16.5 16.5 0 0 0 0-4h3.4a8 8 0 0 1 0 4z',
};
const contact = [
  { i: ico.mail, a: `mailto:${business.email}`, l: 'Connect With Us Now!', v: business.email },
  { i: ico.phone, a: `tel:${hq.phoneE164}`, l: 'Phone Number:', v: '+1-561-654-8998' },
  { i: ico.phone, a: `tel:${pompano.phoneE164}`, l: 'Pompano Beach Phone Number:', v: '+1-954-751-1620' },
  { i: ico.globe, a: hq.maps, l: 'Lake Worth Beach:', v: `${hq.street}, ${hq.city}, ${hq.state} ${hq.zip}` },
  { i: ico.globe, a: pompano.maps, l: 'Pompano Beach:', v: `${pompano.street}, ${pompano.city}, ${pompano.state} ${pompano.zip}` },
];
---
<footer class="site-footer">
  <div class="wrap fgrid">
    <div class="fbrand">
      <a href="/"><img src={business.headerLogo} alt={`${business.name} logo`} width="328" height="161" loading="lazy" /></a>
      <p>{business.tagline}</p>
    </div>
    <div>
      <h2 class="fh">Quick Links</h2>
      <ul class="flinks">{quick.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="fh">Services</h2>
      <ul class="flinks">{services.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="fh">Contact Us</h2>
      <ul class="fcontact">
        {contact.map((c) => (
          <li><a href={c.a} rel={c.a.startsWith('http') ? 'noopener' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={c.i} /></svg><span>{c.l}<b>{c.v}</b></span></a></li>
        ))}
      </ul>
      <div class="fhelp">
        <p>Need Professional <strong>Pest Help Today?</strong></p>
        <a href={`tel:${hq.phoneE164}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ico.phone} /></svg>Call Us Now!</a>
      </div>
    </div>
  </div>
  <div class="fbase">Copyright © {year} {business.name} – All Rights Reserved.</div>
</footer>
