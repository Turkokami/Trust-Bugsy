---
import SpeedInsights from '@vercel/speed-insights/astro';
// Self-hosted fonts (same families and weights the Google Fonts link loaded).
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-400-italic.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto/latin-700-italic.css';
import '@fontsource/roboto/latin-900.css';
import '@fontsource/oswald/latin-500.css';
import '@fontsource/oswald/latin-700.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PhoneBar from '@/components/PhoneBar.astro';
import { business } from '@/data/business';
import { buildGraph, type Crumb, type Faq } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  service?: string;
  faqs?: Faq[];
  article?: { headline: string; author?: string; published?: string };
  image?: string;
  noindex?: boolean;
  office?: string;
  city?: string;
}
const { title, description, path, crumbs = [{ name: 'Home', path: '/' }], service, faqs, image, article, noindex = false, office, city } = Astro.props;
// The office that serves this page's county (Broward pages -> Pompano Beach).
const loc = business.locations.find((l) => l.id === office) ?? business.locations[0];
const canonical = new URL(path, business.url).href;
const TITLE_MAX = 60;
const suffixed = `${title} | ${business.shortName}`;
const fullTitle = /bugsy/i.test(title) || suffixed.length > TITLE_MAX ? title : suffixed;
const share = image ?? business.heroImage;
const graph = buildGraph({ path, title: fullTitle, description, crumbs, service, faqs, image, article, office: loc.id, city });
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={share} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share} />
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content={`${city ?? loc.city}, Florida`} />
    <link rel="icon" href={business.logo} type="image/webp" />
    <link rel="preconnect" href="https://trustbugsy.com" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {/* Vercel Speed Insights (free tier): first-party page-speed readings, cookieless. */}
    <SpeedInsights />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <PhoneBar phone={loc.phoneE164} />
    <dialog id="video-modal" class="video-modal" aria-label="Bugsy’s Pest Solutions video">
      <form method="dialog"><button class="vm-close" aria-label="Close video">×</button></form>
      <div class="vm-frame"><iframe title="Bugsy’s Pest Solutions video" src="about:blank" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
    </dialog>
    <script is:inline>
      document.querySelectorAll('[data-preview-form]').forEach(function (f) {
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var hp = f.querySelector('[name="secondary_ref"]'); if (hp) hp.value = '';
          var n = f.querySelector('.form-note'); if (n) n.hidden = false;
        });
      });
      // Sliders: arrows, autoplay (paused on hover/focus and for reduced motion).
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('.tb-carousel').forEach(function (c) {
        var track = c.querySelector('.tc-track'), prev = c.querySelector('.tc-prev'), next = c.querySelector('.tc-next');
        var step = function () { var s = track.querySelector('.tc-slide'); return s ? s.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 16) : track.clientWidth; };
        var atEnd = function () { return track.scrollLeft + track.clientWidth >= track.scrollWidth - 4; };
        var go = function (d) { if (d > 0 && atEnd()) track.scrollTo({ left: 0 }); else if (d < 0 && track.scrollLeft < 4) track.scrollTo({ left: track.scrollWidth }); else track.scrollBy({ left: d * step() }); };
        var fit = function () { var over = track.scrollWidth > track.clientWidth + 4; prev.hidden = next.hidden = !over; return over; };
        prev.addEventListener('click', function () { go(-1); });
        next.addEventListener('click', function () { go(1); });
        fit(); window.addEventListener('resize', fit);
        var ms = +c.dataset.autoplay || 0, hold = false;
        if (ms && !still) {
          ['mouseenter', 'focusin', 'touchstart'].forEach(function (e) { c.addEventListener(e, function () { hold = true; }, { passive: true }); });
          ['mouseleave', 'focusout'].forEach(function (e) { c.addEventListener(e, function () { hold = false; }); });
          setInterval(function () { if (!hold && !document.hidden && fit()) go(1); }, ms);
        }
      });
      // "Play Video" opens the Bugsy's YouTube video in a popup.
      var vm = document.getElementById('video-modal');
      document.querySelectorAll('[data-video]').forEach(function (b) {
        b.addEventListener('click', function () {
          if (!vm || !vm.showModal) { window.open('https://www.youtube.com/watch?v=' + b.dataset.video, '_blank', 'noopener'); return; }
          vm.querySelector('iframe').src = 'https://www.youtube-nocookie.com/embed/' + b.dataset.video + '?autoplay=1&rel=0';
          vm.showModal();
        });
      });
      if (vm) {
        vm.addEventListener('close', function () { vm.querySelector('iframe').src = 'about:blank'; });
        vm.addEventListener('click', function (e) { if (e.target === vm) vm.close(); });
      }
    </script>
  </body>
</html>
